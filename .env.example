# DYD Assistant Configuration
ASSISTANT_NAME=DYD
USER_NAME=Sir

# AI provider: GEMINI, OLLAMA, OPENAI or CLAUDE (can also be changed in Settings)
AI_PROVIDER=GEMINI

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Anthropic Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Optional: local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: WhatsApp contacts (country code + number, no '+' or spaces)
# DAD=94771234567
# MOM=94771234567
